# ──────────────────────────────────────────────────────────────
# Copy this file to .env and adjust values as needed.
# Real .env is gitignored — it stays on your machine only.
# ──────────────────────────────────────────────────────────────

# ─── Environment ──────────────────────────────────────────────
# Deployment under test. Currently supported: demo
TEST_ENV=demo

# ─── Application ──────────────────────────────────────────────
BASE_URL=https://opensource-demo.orangehrmlive.com

# ─── Credentials (demo site public credentials) ───────────────
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=admin123

# ─── Timeouts in milliseconds ─────────────────────────────────
TEST_TIMEOUT=90000
ACTION_TIMEOUT=20000
NAVIGATION_TIMEOUT=30000
EXPECT_TIMEOUT=10000

# ─── Execution ────────────────────────────────────────────────
# Worker processes. Demo site is shared infra — 4 parallel browsers
# stall it (verified); keep at 2 unless targeting dedicated infra.
WORKERS=2

# Set to false locally to watch the browser run.
HEADLESS=true

# Retries: 1 locally (shared demo server randomly stalls >30s — verified),
# 2 on CI. Genuine failures still fail every attempt.
# Simulate CI locally with: CI=true npm test
# RETRIES=2
